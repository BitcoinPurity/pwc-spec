        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "Hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RpcId"
        },
        "method": {
          "$ref": "https://purity-wallet-connect.invalid/schema/pwc-core-0.2.1.schema.json#/$defs/MethodName"
