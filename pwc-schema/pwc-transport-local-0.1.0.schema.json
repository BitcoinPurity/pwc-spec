    "DelegatePrincipal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "web_origin"
        },
        "origin": {
          "type": "string",
          "pattern": "^(https://[^/?#\\s]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?)$"
