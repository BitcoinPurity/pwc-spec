  "scopes": [
    {
      "name": "wallets:read",
      "grants": "Wallet/account inventory",
      "approval": "Explicit initial disclosure consent"
    },
    {
      "name": "balances:read",
      "grants": "`account.getBalance`",
      "approval": "Grant required"
    },
    {
      "name": "addresses:read",
      "grants": "Existing/current addresses",
      "approval": "Grant required"
    },
    {
      "name": "addresses:create",
      "grants": "New receive address",
      "approval": "Explicit grant; no payment implied"
    },
    {
      "name": "transactions:read",
      "grants": "Account transaction history",
      "approval": "Grant required"
    },
    {
      "name": "utxos:read",
      "grants": "Outpoints and coin-selection metadata",
      "approval": "Privacy-sensitive grant"
    },
    {
      "name": "psbt:create",
      "grants": "Construct PSBT using an account's resources; release its reservations",
      "approval": "Grant plus local wallet policy; discloses the selected coins (Core §4.7)"
    },
    {
      "name": "psbt:sign",
      "grants": "Request signatures for selected inputs",
      "approval": "**Individual approval of every transaction**"
    },
    {
      "name": "transactions:broadcast",
      "grants": "Submit raw transaction to wallet-selected backend",
      "approval": "Grant plus applicable local policy"
    },
    {
      "name": "messages:sign",
      "grants": "Request supported message signature",
      "approval": "**Individual approval of every message**"
    },
    {
      "name": "events:read",
      "grants": "Deliver authorized state-change events",
      "approval": "Underlying read scopes still enforced"
    }
  ],
  "features": [
    {
      "name": "coin_control",
      "meaning": "`psbt.create` honors `selected_utxos`"
    },
    {
      "name": "multisig",
      "meaning": "The Provider handles multisignature accounts"
    },
    {
      "name": "hardware_signing",
      "meaning": "The Provider can sign through hardware devices"
    },
    {
      "name": "watch_only",
      "meaning": "The Provider handles watch-only accounts"
    },
    {
      "name": "event_push",
      "meaning": "The Provider delivers the events of Core §8.6 through a transport profile"
    }
  ],
