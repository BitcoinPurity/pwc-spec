{
  "description": "PSBT fixtures for PWC-CORE-001 v0.2.1 \u00a74.7 and \u00a78.3, covering Core tests C-11 to C-14, C-40 and C-55. 2-of-2 P2WSH input of 100,000 sat on regtest, one output of 99,000 sat, fee 1,000 sat. Compare PSBTs by their sets of key-value pairs, not by bytes, because serializations may order keys differently.",
  "keys": {
    "k1": "025a992d6972ec621ce76b9b0673c44c77dedc9bebc01fb0cedc3b7d60d306fd68",
    "k2": "0353cd1c81ed76af62f9d522946c7bf21c9996e182b8275583f9ac757bad6b8f37",
    "note": "Private keys are SHA-256('PWC test key 1') and SHA-256('PWC test key 2'). Test only."
  },
  "psbts": {
    "unsigned": "cHNidP8BAFICAAAAAaqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqAAAAAAD/////AbiCAQAAAAAAFgAU3CKDIn6hTwDX+sUD2qCb+6wjr0UAAAAAAAEBK6CGAQAAAAAAIgAgXPRh7RHzoPlBSBdzmADrwc3kEaQdkqUCmDQf3OOoHhEBBUdSIQJamS1pcuxiHOdrmwZzxEx33tyb68AfsM7cO31g0wb9aCEDU80cge12r2L51SKUbHvyHJmW4YK4J1WD+ax1e61rjzdSrgAA",
    "partial_k1": "",
    "partial_k2": "",
    "partial_k1_anyonecanpay": "",
    "partial_k1_corrupted": "",
    "other_transaction_k2": "",
    "combined": "",
    "version2": "cHNidP8BAgQCAAAAAQQBAQEFAQEB+wQCAAAAAAEOIKqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqAQ8EAAAAAAEBK6CGAQAAAAAAIgAgXPRh7RHzoPlBSBdzmADrwc3kEaQdkqUCmDQf3OOoHhEAAQMIuIIBAAAAAAABBBYAFNwigyJ+oU8A1/rFA9qgm/usI69FAA=="
  },
  "finalized": {
    "raw_transaction": "",
    "txid": "1922282d242f24371e83c583f7116d030cb2051a94e47fbfb6d86c9bd0f685ac"
  },
  "cases": [
    {
      "id": "PSBT-01",
      "method": "psbt.combine",
      "inputs": [
        "partial_k1",
        "partial_k2"
      ],
      "expect": {
        "result_equals": "combined"
      }
    },
    {
      "id": "PSBT-02",
      "method": "psbt.combine",
      "inputs": [
        "partial_k1",
        "other_transaction_k2"
      ],
      "expect": {
        "error": "PSBT_CONFLICT"
      }
    },
    {
      "id": "PSBT-03",
      "method": "psbt.combine",
      "inputs": [
        "partial_k1",
        "version2"
      ],
      "expect": {
        "error": "UNSUPPORTED_PSBT_VERSION"
      }
    },
    {
      "id": "PSBT-04",
      "method": "psbt.combine",
      "inputs": [
        "partial_k1",
        "partial_k1_anyonecanpay"
      ],
      "expect": {
        "result_equals": "partial_k1",
        "note": "both signatures verify; the first submitted value is kept"
      }
    },
    {
      "id": "PSBT-05",
      "method": "psbt.combine",
      "inputs": [
        "partial_k1",
        "partial_k1_corrupted"
      ],
      "expect": {
        "error": "PSBT_CONFLICT"
      }
    },
    {
      "id": "PSBT-06",
      "method": "psbt.finalize",
      "inputs": [
        "partial_k1"
      ],
      "expect": {
        "complete": false
      }
    },
    {
      "id": "PSBT-07",
      "method": "psbt.finalize",
      "inputs": [
        "combined"
      ],
      "expect": {
        "complete": true,
        "raw_transaction": "",
        "txid": "1922282d242f24371e83c583f7116d030cb2051a94e47fbfb6d86c9bd0f685ac"
      }
    },
    {
      "id": "PSBT-08",
      "method": "psbt.finalize",
      "inputs": [
        "version2"
      ],
      "expect": {
        "error": "UNSUPPORTED_PSBT_VERSION"
      }
    }
  ]
}